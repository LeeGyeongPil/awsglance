# awsglance 는 API 키가 필요 없다. 실제 모드는 표준 AWS 자격증명 체인(환경 변수·프로필·SSO·역할)을 그대로 쓴다.
# 연습 모드(awsglance --demo)는 아무 설정 없이 동작한다. 아래는 모두 선택 항목이다. 키 값을 이 파일에 적지 않는다.

# 실제 모드에서 쓸 AWS 프로필 이름(SSO 로 로그인한 프로필 등)
# AWS_PROFILE=myprof

# 기본 리전. 비우면 DescribeRegions 로 활성 리전을 자동으로 찾는다
# AWS_REGION=ap-northeast-2

# SQLite DB·토큰을 둘 폴더(기본 ~/.local/share/awsglance, 권한 0700)
# AWSGLANCE_DATA_DIR=

# 127.0.0.1 이 아닌 주소로 바인드할 때 쓸 접근 토큰(비우면 자동 생성해 데이터 폴더의 token 파일(0600)에 저장)
# AWSGLANCE_TOKEN=

# 화면·CLI 메시지 언어(en 또는 ko). --lang 이 더 우선하고, 없으면 LC_ALL·LC_MESSAGES·LANG 을 보며, 한국어가 아니면 영어
# UI/CLI message language (en or ko). --lang wins; otherwise LC_ALL/LC_MESSAGES/LANG are used; anything but Korean falls back to English.
# AWSGLANCE_LANG=ko
