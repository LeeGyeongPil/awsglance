{
  "_comment": "가상 계정 123456789012 의 Describe/List 원본 응답. '_only' 가 before 인 항목은 첫 스냅샷에만, after 인 항목은 두 번째 스냅샷에만 있다. 일부러 넣은 실수: 22·3389 포트 전 세계 개방 SG, 공개 차단 없는 버킷, 120일 된 액세스 키, 공개 RDS, 인증 없는 함수 URL, 보존 기간 없는 로그 그룹. 환경 변수 값은 '저장 전 가림'을 보여 주려고 넣은 가짜 값이다. 연결 주체는 ViewOnly 역할이라 계정 수준 S3 공개 차단 조회(s3:GetAccountPublicAccessBlock)가 거부된다 — 권한 점검 표의 '거부'와 보안 태세의 '권한 없음'(꺼짐으로 단정하지 않음)을 보여 주려는 설정이다.",
  "services": {
    "sts": {
      "*": {
        "GetCallerIdentity": {
          "Account": "123456789012",
          "Arn": "arn:aws:sts::123456789012:assumed-role/AWSReservedSSO_ViewOnly_0demo/demo-viewer",
          "UserId": "AROADEMOEXAMPLE0VIEW:demo-viewer"
        }
      }
    },
    "ec2": {
      "ap-northeast-2": {
        "DescribeRegions": {"Regions": [{"RegionName": "ap-northeast-2"}, {"RegionName": "us-east-1"}]},
        "DescribeInstances": {"Reservations": [{"Instances": [
          {"InstanceId": "i-0demoweb10000001", "InstanceType": "t3.small", "State": {"Name": "running"},
           "PublicIpAddress": "203.0.113.10", "VpcId": "vpc-0demomain000001", "SubnetId": "subnet-0demopuba00001",
           "SecurityGroups": [{"GroupId": "sg-0demoweb0000002"}], "LaunchTime": "@ago:40d",
           "Tags": [{"Key": "Name", "Value": "demo-web-1"}, {"Key": "Service", "Value": "web"}]},
          {"_only": "before", "InstanceId": "i-0demoweb20000002", "InstanceType": "t3.small", "State": {"Name": "running"},
           "PublicIpAddress": "203.0.113.11", "VpcId": "vpc-0demomain000001", "SubnetId": "subnet-0demopubc00002",
           "SecurityGroups": [{"GroupId": "sg-0demoweb0000002"}], "LaunchTime": "@ago:40d",
           "Tags": [{"Key": "Name", "Value": "demo-web-2"}, {"Key": "Service", "Value": "web"}]},
          {"_only": "after", "InstanceId": "i-0demoweb20000002", "InstanceType": "t3.small", "State": {"Name": "stopped"},
           "VpcId": "vpc-0demomain000001", "SubnetId": "subnet-0demopubc00002",
           "SecurityGroups": [{"GroupId": "sg-0demoweb0000002"}], "LaunchTime": "@ago:40d",
           "Tags": [{"Key": "Name", "Value": "demo-web-2"}, {"Key": "Service", "Value": "web"}]},
          {"InstanceId": "i-0demobatch000003", "InstanceType": "c6g.large", "State": {"Name": "running"},
           "VpcId": "vpc-0demomain000001", "SubnetId": "subnet-0demoprva00003",
           "SecurityGroups": [{"GroupId": "sg-0demodb00000003"}], "LaunchTime": "@ago:11d",
           "IamInstanceProfile": {"Arn": "arn:aws:iam::123456789012:instance-profile/demo-batch"},
           "Tags": [{"Key": "Name", "Value": "demo-batch-1"}, {"Key": "Service", "Value": "batch"}]},
          {"_only": "after", "InstanceId": "i-0demoworker00004", "InstanceType": "t3.medium", "State": {"Name": "running"},
           "VpcId": "vpc-0demomain000001", "SubnetId": "subnet-0demoprvc00004",
           "SecurityGroups": [{"GroupId": "sg-0demodb00000003"}], "LaunchTime": "@ago:10h",
           "Tags": [{"Key": "Name", "Value": "demo-worker-1"}, {"Key": "Service", "Value": "batch"}]}
        ]}]},
        "DescribeVpcs": {"Vpcs": [
          {"VpcId": "vpc-0demomain000001", "CidrBlock": "10.20.0.0/16", "IsDefault": false,
           "Tags": [{"Key": "Name", "Value": "demo-main"}]},
          {"VpcId": "vpc-0demodefault002", "CidrBlock": "172.31.0.0/16", "IsDefault": true}
        ]},
        "DescribeSubnets": {"Subnets": [
          {"SubnetId": "subnet-0demopuba00001", "VpcId": "vpc-0demomain000001", "CidrBlock": "10.20.0.0/24",
           "AvailabilityZone": "ap-northeast-2a", "MapPublicIpOnLaunch": true, "Tags": [{"Key": "Name", "Value": "demo-public-a"}]},
          {"SubnetId": "subnet-0demopubc00002", "VpcId": "vpc-0demomain000001", "CidrBlock": "10.20.1.0/24",
           "AvailabilityZone": "ap-northeast-2c", "MapPublicIpOnLaunch": true, "Tags": [{"Key": "Name", "Value": "demo-public-c"}]},
          {"SubnetId": "subnet-0demoprva00003", "VpcId": "vpc-0demomain000001", "CidrBlock": "10.20.10.0/24",
           "AvailabilityZone": "ap-northeast-2a", "Tags": [{"Key": "Name", "Value": "demo-private-a"}]},
          {"SubnetId": "subnet-0demoprvc00004", "VpcId": "vpc-0demomain000001", "CidrBlock": "10.20.11.0/24",
           "AvailabilityZone": "ap-northeast-2c", "Tags": [{"Key": "Name", "Value": "demo-private-c"}]}
        ]},
        "DescribeSecurityGroups": {"SecurityGroups": [
          {"GroupId": "sg-0demodefault001", "GroupName": "default", "VpcId": "vpc-0demomain000001",
           "Description": "default VPC security group",
           "IpPermissions": [{"IpProtocol": "-1", "IpRanges": [{"CidrIp": "10.20.0.0/16"}]}],
           "IpPermissionsEgress": [{"IpProtocol": "-1", "IpRanges": [{"CidrIp": "0.0.0.0/0"}]}]},
          {"_only": "before", "GroupId": "sg-0demoweb0000002", "GroupName": "demo-web", "VpcId": "vpc-0demomain000001",
           "Description": "web servers",
           "IpPermissions": [
             {"IpProtocol": "tcp", "FromPort": 80, "ToPort": 80, "IpRanges": [{"CidrIp": "0.0.0.0/0"}]},
             {"IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "IpRanges": [{"CidrIp": "0.0.0.0/0"}]}],
           "IpPermissionsEgress": [{"IpProtocol": "-1", "IpRanges": [{"CidrIp": "0.0.0.0/0"}]}],
           "Tags": [{"Key": "Service", "Value": "web"}]},
          {"_only": "after", "GroupId": "sg-0demoweb0000002", "GroupName": "demo-web", "VpcId": "vpc-0demomain000001",
           "Description": "web servers",
           "IpPermissions": [
             {"IpProtocol": "tcp", "FromPort": 80, "ToPort": 80, "IpRanges": [{"CidrIp": "0.0.0.0/0"}]},
             {"IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "IpRanges": [{"CidrIp": "0.0.0.0/0"}]},
             {"IpProtocol": "tcp", "FromPort": 22, "ToPort": 22, "IpRanges": [{"CidrIp": "0.0.0.0/0"}]}],
           "IpPermissionsEgress": [{"IpProtocol": "-1", "IpRanges": [{"CidrIp": "0.0.0.0/0"}]}],
           "Tags": [{"Key": "Service", "Value": "web"}]},
          {"GroupId": "sg-0demodb00000003", "GroupName": "demo-db", "VpcId": "vpc-0demomain000001",
           "Description": "database access from web",
           "IpPermissions": [{"IpProtocol": "tcp", "FromPort": 5432, "ToPort": 5432,
                              "UserIdGroupPairs": [{"GroupId": "sg-0demoweb0000002"}]}],
           "IpPermissionsEgress": [{"IpProtocol": "-1", "IpRanges": [{"CidrIp": "0.0.0.0/0"}]}]},
          {"GroupId": "sg-0demoalb0000004", "GroupName": "demo-alb", "VpcId": "vpc-0demomain000001",
           "Description": "public load balancer",
           "IpPermissions": [{"IpProtocol": "tcp", "FromPort": 443, "ToPort": 443,
                              "IpRanges": [{"CidrIp": "0.0.0.0/0"}], "Ipv6Ranges": [{"CidrIpv6": "::/0"}]}],
           "IpPermissionsEgress": [{"IpProtocol": "-1", "IpRanges": [{"CidrIp": "0.0.0.0/0"}]}]},
          {"_only": "after", "GroupId": "sg-0demoadmin00005", "GroupName": "demo-admin", "VpcId": "vpc-0demomain000001",
           "Description": "temporary admin access",
           "IpPermissions": [{"IpProtocol": "tcp", "FromPort": 3389, "ToPort": 3389, "IpRanges": [{"CidrIp": "0.0.0.0/0"}]}],
           "IpPermissionsEgress": [{"IpProtocol": "-1", "IpRanges": [{"CidrIp": "0.0.0.0/0"}]}]}
        ]}
      },
      "us-east-1": {
        "DescribeRegions": {"Regions": [{"RegionName": "ap-northeast-2"}, {"RegionName": "us-east-1"}]},
        "DescribeVpcs": {"Vpcs": [{"VpcId": "vpc-0demouse1def001", "CidrBlock": "172.31.0.0/16", "IsDefault": true}]},
        "DescribeSubnets": {"Subnets": [
